<?xml version="1.0" encoding="utf-8" ?>
<!-- Composant réutilisable (équivalent du composant Figma "état") :
     titre coloré + message + indicateur de chargement + bouton d'action optionnel. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TaskifyHR.Controls.StateView"
             x:Name="Self">
    <VerticalStackLayout Spacing="6">
        <Label Text="{Binding Title, Source={x:Reference Self}}"
               TextColor="{Binding TitleColor, Source={x:Reference Self}}"
               FontAttributes="Bold"
               FontSize="14" />
        <Border Style="{StaticResource Card}">
            <VerticalStackLayout Spacing="12">
                <Label Text="{Binding Message, Source={x:Reference Self}}"
                       Style="{StaticResource BodyLabel}" />
                <HorizontalStackLayout Spacing="8"
                                       IsVisible="{Binding IsBusy, Source={x:Reference Self}}">
                    <ActivityIndicator IsRunning="True"
                                       Color="{StaticResource Primary}"
                                       HeightRequest="20" WidthRequest="20" />
                    <Label Text="Chargement…"
                           Style="{StaticResource CaptionLabel}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Button Text="{Binding ActionText, Source={x:Reference Self}}"
                        Command="{Binding ActionCommand, Source={x:Reference Self}}"
                        IsVisible="{Binding HasAction, Source={x:Reference Self}}"
                        Style="{StaticResource SecondaryButton}" />
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</ContentView>
