<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:TaskifyHR.Controls"
             x:Class="TaskifyHR.Views.ManagerPage"
             Title="Validation manager">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <VerticalStackLayout Spacing="4">
                <Label Text="{Binding HeroTitle}" Style="{StaticResource TitleLabel}" />
                <Label Text="{Binding HeroSubtitle}" Style="{StaticResource BodyLabel}" />
            </VerticalStackLayout>

            <!-- Chargement -->
            <HorizontalStackLayout Spacing="8" IsVisible="{Binding IsLoading}">
                <ActivityIndicator IsRunning="True" Color="{StaticResource Primary}"
                                   HeightRequest="20" WidthRequest="20" />
                <Label Text="Chargement des demandes…" Style="{StaticResource CaptionLabel}"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- Accès réservé -->
            <controls:StateView IsVisible="{Binding IsDenied}"
                                Title="Accès réservé"
                                TitleColor="{StaticResource Error}"
                                Message="Cet espace est réservé aux managers."
                                ActionText="Retour"
                                ActionCommand="{Binding BackCommand}" />

            <!-- Erreur de chargement -->
            <controls:StateView IsVisible="{Binding HasError}"
                                Title="Erreur de chargement"
                                TitleColor="{StaticResource Error}"
                                Message="Impossible de charger les demandes. Vérifiez votre connexion."
                                ActionText="Réessayer"
                                ActionCommand="{Binding LoadCommand}" />

            <!-- Liste vide -->
            <controls:StateView IsVisible="{Binding IsEmpty}"
                                Title="Liste vide"
                                TitleColor="{StaticResource TextPrimary}"
                                Message="Toutes les demandes ont été traitées. Aucune demande en attente." />

            <!-- Une carte par demande ; son contenu change selon sa phase -->
            <VerticalStackLayout Spacing="20" BindableLayout.ItemsSource="{Binding Items}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout>

                            <!-- 1) En attente de décision -->
                            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsPending}">
                                <Border Style="{StaticResource Card}">
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="{Binding EmployeeName}" Style="{StaticResource SubtitleLabel}" />
                                        <Label Text="{Binding DateAndDays}" Style="{StaticResource BodyLabel}" />
                                        <Label Text="{Binding TypeAndReason}" Style="{StaticResource BodyLabel}" />
                                        <Label Text="{Binding BalanceLine}" Style="{StaticResource BodyLabel}" />
                                    </VerticalStackLayout>
                                </Border>
                                <controls:StatusBadge Status="Pending" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <Button Grid.Column="0" Text="{Binding ApproveText}"
                                            Command="{Binding ApproveCommand}"
                                            Style="{StaticResource PrimaryButton}" />
                                    <Button Grid.Column="1" Text="Refuser"
                                            Command="{Binding StartRefusalCommand}"
                                            Style="{StaticResource SecondaryButton}" />
                                </Grid>
                            </VerticalStackLayout>

                            <!-- 2) Refus en cours : motif obligatoire -->
                            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsRefusing}">
                                <Label Text="Refus · motif obligatoire"
                                       TextColor="{StaticResource Error}"
                                       FontAttributes="Bold" FontSize="14" />
                                <Border Style="{StaticResource Card}">
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="{Binding EmployeeName}" Style="{StaticResource SubtitleLabel}" />
                                        <Label Text="{Binding RefusalSummary}" Style="{StaticResource BodyLabel}" />
                                        <Label Text="Indiquez le motif de votre refus." Style="{StaticResource BodyLabel}" />
                                    </VerticalStackLayout>
                                </Border>
                                <Label Text="Motif du refus *" Style="{StaticResource CaptionLabel}" />
                                <Border Style="{StaticResource Field}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding HasReasonError}" Value="True">
                                            <Setter Property="Stroke" Value="{StaticResource Error}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Entry Text="{Binding RefusalReason}" Placeholder="Ex. : présence requise" />
                                </Border>
                                <Label Text="Le motif du refus est obligatoire."
                                       IsVisible="{Binding HasReasonError}"
                                       Style="{StaticResource ErrorLabel}" />
                                <Button Text="{Binding ConfirmText}"
                                        Command="{Binding ConfirmRefusalCommand}"
                                        Style="{StaticResource PrimaryButton}" />
                                <Button Text="Annuler"
                                        Command="{Binding CancelRefusalCommand}"
                                        Style="{StaticResource LinkButton}" />
                            </VerticalStackLayout>

                            <!-- 3) Approbation confirmée -->
                            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsApproved}">
                                <controls:StateView Title="Approbation confirmée"
                                                    TitleColor="{StaticResource Success}"
                                                    Message="{Binding ResultMessage}" />
                                <controls:StatusBadge Status="Approved" />
                            </VerticalStackLayout>

                            <!-- 4) Refus confirmé -->
                            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsRefused}">
                                <controls:StateView Title="Refus confirmé"
                                                    TitleColor="{StaticResource Success}"
                                                    Message="{Binding ResultMessage}" />
                                <controls:StatusBadge Status="Refused" />
                            </VerticalStackLayout>

                            <!-- Erreur de la décision (solde insuffisant, réseau...) -->
                            <Label Text="{Binding ErrorMessage}"
                                   IsVisible="{Binding HasError}"
                                   Style="{StaticResource ErrorLabel}" FontSize="14" Margin="0,8,0,0" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Label Text="Tout refus doit être accompagné d'un motif. La décision est communiquée au salarié."
                   Style="{StaticResource CaptionLabel}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
