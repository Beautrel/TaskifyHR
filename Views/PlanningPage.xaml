<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:TaskifyHR.Controls"
             x:Class="TaskifyHR.Views.PlanningPage"
             Title="Planning">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <Label Text="{Binding MonthTitle}" Style="{StaticResource TitleLabel}" />

            <!-- Chargement -->
            <HorizontalStackLayout Spacing="8" IsVisible="{Binding IsLoading}">
                <ActivityIndicator IsRunning="True" Color="{StaticResource Primary}"
                                   HeightRequest="20" WidthRequest="20" />
                <Label Text="{Binding LoadingMessage}" Style="{StaticResource CaptionLabel}"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- Erreur de chargement -->
            <controls:StateView IsVisible="{Binding HasError}"
                                Title="Erreur de chargement"
                                TitleColor="{StaticResource Error}"
                                Message="Impossible de charger le planning. Vérifiez votre connexion."
                                ActionText="Réessayer"
                                ActionCommand="{Binding LoadCommand}" />

            <!-- Calendrier -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding ShowCalendar}">

                <Grid ColumnDefinitions="*,*">
                    <Button Grid.Column="0" Text="‹ Mois précédent"
                            Command="{Binding PreviousMonthCommand}"
                            Style="{StaticResource LinkButton}" />
                    <Button Grid.Column="1" Text="Mois suivant ›"
                            Command="{Binding NextMonthCommand}"
                            Style="{StaticResource LinkButton}"
                            HorizontalOptions="End" />
                </Grid>

                <!-- Jours de la semaine (le calendrier commence le lundi) -->
                <Grid ColumnDefinitions="*,*,*,*,*,*,*">
                    <Label Grid.Column="0" Text="L" Style="{StaticResource CaptionLabel}" HorizontalTextAlignment="Center" />
                    <Label Grid.Column="1" Text="M" Style="{StaticResource CaptionLabel}" HorizontalTextAlignment="Center" />
                    <Label Grid.Column="2" Text="M" Style="{StaticResource CaptionLabel}" HorizontalTextAlignment="Center" />
                    <Label Grid.Column="3" Text="J" Style="{StaticResource CaptionLabel}" HorizontalTextAlignment="Center" />
                    <Label Grid.Column="4" Text="V" Style="{StaticResource CaptionLabel}" HorizontalTextAlignment="Center" />
                    <Label Grid.Column="5" Text="S" Style="{StaticResource CaptionLabel}" HorizontalTextAlignment="Center" />
                    <Label Grid.Column="6" Text="D" Style="{StaticResource CaptionLabel}" HorizontalTextAlignment="Center" />
                </Grid>

                <!-- Cases du mois : chaque case est placée par sa ligne et sa colonne -->
                <Grid ColumnDefinitions="*,*,*,*,*,*,*"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                      BindableLayout.ItemsSource="{Binding Days}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border Grid.Row="{Binding Row}" Grid.Column="{Binding Column}"
                                    Margin="2" HeightRequest="44"
                                    StrokeThickness="1"
                                    Stroke="{StaticResource Outline}"
                                    BackgroundColor="{StaticResource Surface}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding Kind}" Value="Pending">
                                        <Setter Property="BackgroundColor" Value="{StaticResource Warning}" />
                                        <Setter Property="Stroke" Value="{StaticResource Warning}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding Kind}" Value="Approved">
                                        <Setter Property="BackgroundColor" Value="{StaticResource Success}" />
                                        <Setter Property="Stroke" Value="{StaticResource Success}" />
                                    </DataTrigger>
                                    <!-- Aujourd'hui : contour sombre épais -->
                                    <DataTrigger TargetType="Border" Binding="{Binding IsToday}" Value="True">
                                        <Setter Property="Stroke" Value="{StaticResource TextPrimary}" />
                                        <Setter Property="StrokeThickness" Value="2" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label Text="{Binding Number}" FontSize="14"
                                       HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsWeekend}" Value="True">
                                            <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding Kind}" Value="Pending">
                                            <Setter Property="TextColor" Value="{StaticResource OnWarning}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding Kind}" Value="Approved">
                                            <Setter Property="TextColor" Value="{StaticResource White}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </Grid>

                <Label Text="Contour : aujourd'hui · Orange : en attente · Vert : approuvé"
                       Style="{StaticResource CaptionLabel}" />
            </VerticalStackLayout>

            <!-- Planning vide -->
            <controls:StateView IsVisible="{Binding IsEmpty}"
                                Title="Planning vide"
                                TitleColor="{StaticResource TextPrimary}"
                                Message="Aucun événement sur cette période. Les journées et congés apparaîtront ici."
                                ActionText="Revenir à ce mois"
                                ActionCommand="{Binding BackToCurrentMonthCommand}" />

            <!-- Cartes : aujourd'hui + congés du mois -->
            <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Events}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="{Binding Title}" Style="{StaticResource SubtitleLabel}" />
                                <Label Text="{Binding Detail}" Style="{StaticResource BodyLabel}" />
                                <controls:StatusBadge Status="{Binding Status}" IsVisible="{Binding HasBadge}" />
                                <Label Text="{Binding Note}" IsVisible="{Binding HasNote}"
                                       Style="{StaticResource CaptionLabel}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
