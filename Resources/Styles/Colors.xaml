<?xml version="1.0" encoding="UTF-8" ?>
<!-- Charte graphique Taskify HR : toutes les couleurs de l'application sont ici. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="Primary">#1F4E79</Color>
    <Color x:Key="PrimaryPressed">#173B5C</Color>
    <Color x:Key="Success">#2E7D32</Color>
    <Color x:Key="Warning">#ED6C02</Color>
    <Color x:Key="OnWarning">#1A1A1A</Color>
    <Color x:Key="Error">#C62828</Color>
    <Color x:Key="TextPrimary">#1A1A1A</Color>
    <Color x:Key="TextSecondary">#5F6368</Color>
    <Color x:Key="Outline">#E0E0E0</Color>
    <Color x:Key="PageBackground">#F5F7FA</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="DisabledBackground">#A9B9C9</Color>
    <Color x:Key="White">#FFFFFF</Color>
</ResourceDictionary>
